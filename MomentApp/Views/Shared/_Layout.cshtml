@using MomentApp.Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Moment</title>
    <meta name="theme-color" content="#0c1e31" />
    <link rel="icon" href="~/favicon.ico" />
    <!-- Self-hosted: a webfont request tells a third party the reader's IP and
         which page they are on, room pages included. -->
    <link rel="stylesheet" href="/css/fonts.css" />
    <link rel="stylesheet" href="@ClientAssets.Versioned("/css/moment.css")" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app">
    <header class="app-nav">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">m<span aria-hidden="true">&#9679;</span>ment</a>
            <a class="nav-cta" asp-controller="Room" asp-action="Create">Create a moment</a>
        </div>
    </header>

    <main class="app-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
