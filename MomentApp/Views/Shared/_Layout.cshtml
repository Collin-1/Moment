@using MomentApp.Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Moment</title>
    <meta name="theme-color" content="#0c1e31" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Inter:ital,wght@0,400;0,500;0,600;1,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@ClientAssets.Versioned("/css/moment.css")" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app">
    <header class="app-nav">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">m<span aria-hidden="true">&#9679;</span>ment</a>
            <a class="nav-cta" asp-controller="Room" asp-action="Create">Create a moment</a>
        </div>
    </header>

    <main class="app-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
