@model MomentApp.Models.JoinRoomViewModel
@{
    ViewData["Title"] = "Join a moment";
}

<div class="app-panel">
    <h1 class="app-title">Join a moment</h1>
    <p class="app-sub">Enter the six-character code you were given.</p>

    <form asp-action="Join" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label class="field-label" asp-for="RoomCode" style="text-align: center;">Room code</label>
            @* Uppercased as you type: codes are generated uppercase, and asking someone to
               match the case of something they read off a screen is needless friction. *@
            <input class="field-input code-input"
                   asp-for="RoomCode"
                   maxlength="6"
                   autocomplete="off"
                   autocapitalize="characters"
                   spellcheck="false"
                   data-uppercase
                   autofocus
                   placeholder="XXXXXX" />
            <span class="field-error" asp-validation-for="RoomCode"></span>
        </div>

        <p class="app-aside">
            No code? <a asp-action="Create">Create a moment</a>
        </p>

        <div class="app-actions">
            <button type="submit" class="button primary">Join room</button>
        </div>
    </form>
</div>

@section Scripts {
    <script type="module" src="/js/app.js"></script>
}
