@using MomentApp.Models
@model CreateRoomViewModel
@{
    ViewData["Title"] = "Create a moment";
}

<div class="app-panel">
    <h1 class="app-title">Create a new moment</h1>
    <p class="app-sub">Set up a temporary room that ends on its own.</p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label class="field-label" asp-for="Name">
                Room name: <span class="optional">(optional)</span>
            </label>
            <input class="field-input" asp-for="Name" placeholder="Team Safe" autocomplete="off" />
            <span class="field-error" asp-validation-for="Name"></span>
        </div>

        <div class="field">
            <label class="field-label" asp-for="Description">
                Room description: <span class="optional">(optional)</span>
            </label>
            <input class="field-input" asp-for="Description" placeholder="What is this room for?" autocomplete="off" />
            <span class="field-error" asp-validation-for="Description"></span>
        </div>

        <fieldset class="field">
            <legend class="field-label">Moment duration:</legend>
            <div class="chip-row">
                @foreach (var (minutes, label) in RoomDuration.Presets)
                {
                    <label class="chip">
                        <input type="radio" asp-for="ExpiryMinutes" value="@minutes" />
                        <span>@label</span>
                    </label>
                }
            </div>
            <p class="field-hint">The countdown is visible to everyone in the room.</p>
            <span class="field-error" asp-validation-for="ExpiryMinutes"></span>
        </fieldset>

        <fieldset class="field">
            <legend class="field-label">Room type:</legend>
            <div class="chip-row">
                @foreach (var type in Enum.GetValues<RoomType>())
                {
                    <label class="chip">
                        <input type="radio" asp-for="RoomType" value="@type" />
                        <span>@type</span>
                    </label>
                }
            </div>
            @* Every room supports all three; this only decides what opens first. *@
            <p class="field-hint">Text, voice and video are available in every room &mdash; this just chooses where you land.</p>
        </fieldset>

        <p class="app-aside">
            Have an invite? <a asp-action="Join">Join with a code</a>
        </p>

        <div class="app-actions">
            <button type="submit" class="button primary">Create room</button>
        </div>
    </form>
</div>
