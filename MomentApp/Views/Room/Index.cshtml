@using System.Text.Json
@using MomentApp.Configuration
@model MomentApp.Models.ChatRoomViewModel
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.Room.Name) ? Model.Room.Name : $"Room {Model.Room.Id}";
    var timeRemaining = Model.Room.ExpiresAt - DateTime.UtcNow;
    Layout = null; // Standalone document: the room has its own chrome.

    var clientConfig = new
    {
        roomId = Model.Room.Id,
        roomName = Model.Room.Name,
        participantId = Model.CurrentParticipant.Id,
        displayName = Model.CurrentParticipant.DisplayName,
        colorHex = Model.CurrentParticipant.ColorHex,
        hubUrl = "/hubs/room",
        homeUrl = Url.Action("Index", "Home"),
        closedUrl = Url.Action("Closed", "Room")
        // ICE servers are deliberately absent: TURN credentials are short-lived and must not
        // be baked into cacheable markup. The client fetches them from /api/ice.
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Moment</title>
    <link rel="stylesheet" href="@ClientAssets.Versioned("/css/room.css")" />

    @* Server state reaches the client as JSON rather than interpolated into script source.
       Razor HTML-encodes @@Model expressions, so a display name containing an apostrophe
       used to land inside a JS string literal as a raw &#x27; entity. Serialising with the
       default encoder also escapes the angle brackets, so a closing script tag inside a
       display name is inert. *@
    <script id="moment-config" type="application/json">@Html.Raw(JsonSerializer.Serialize(clientConfig))</script>

    @* Bare specifiers, each carrying the build stamp. A relative import resolves against the
       importing module's URL and would drop any query or fingerprint, so without this the
       entry point would be versioned while its dependencies were not. Must precede any
       module script. *@
    @Html.Raw(ClientAssets.RoomImportMapScript())
</head>
<body>
    <div class="reconnecting-banner" id="reconnectingBanner">
        Reconnecting...
    </div>

    <div class="chat-container">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="room-code">@Model.Room.Id</div>
                @if (!string.IsNullOrEmpty(Model.Room.Name))
                {
                    <div class="room-name">@Model.Room.Name</div>
                }
            </div>

            <div class="timer-section">
                <div class="timer-display" id="timerDisplay">
                    @if (timeRemaining.TotalHours >= 1)
                    {
                        <text>@((int)timeRemaining.TotalHours)h @(timeRemaining.Minutes)m</text>
                    }
                    else
                    {
                        <text>@(timeRemaining.Minutes)m @(timeRemaining.Seconds)s</text>
                    }
                </div>
                <div class="timer-label">Time Remaining</div>
            </div>

            <div class="participants-section">
                <div class="participants-title">
                    Participants (<span id="participantCount">@Model.Room.Participants.Count(p => !p.HasLeft)</span>)
                </div>
                @* Rendered empty: the roster is rebuilt from RoomState the moment the hub
                   connects, so server-rendering it too meant two implementations of the same
                   markup that had already drifted apart. *@
                <div id="participantsList"></div>
            </div>

            <div class="voice-section">
                <div class="voice-header">
                    <span>Voice Call</span>
                    <span><span id="voiceCount">0</span>/10</span>
                </div>
                <div class="voice-status" id="voiceStatus">Not connected</div>
                <div class="voice-buttons">
                    <button class="voice-btn" id="joinVoiceBtn" type="button">Join Voice</button>
                    <button class="voice-btn" id="joinVideoBtn" type="button">Join Video</button>
                    <button class="voice-btn voice-secondary" id="leaveVoiceBtn" type="button" disabled>Leave Voice</button>
                    <button class="voice-btn voice-secondary" id="muteVoiceBtn" type="button" disabled>Mute</button>
                    <button class="voice-btn voice-secondary" id="cameraToggleBtn" type="button" disabled>Camera Off</button>
                </div>
            </div>

            <div class="vote-section">
                <div id="votePanel" style="display: none;"></div>
                <button class="vote-btn" id="voteBtn" type="button">Vote to Close Room</button>
                <button class="leave-btn" id="leaveRoomBtn" type="button">Leave Room</button>
            </div>
        </div>

        <div class="main-chat">
            <div class="chat-header">
                <div class="chat-title">Chat</div>
                <button class="share-btn" id="shareBtn" type="button">Share Room</button>
            </div>

            <div class="video-stage" id="videoStage">
                <div class="video-grid" id="videoGrid"></div>
            </div>

            <div class="messages-area" id="messagesArea"></div>

            <button class="scroll-to-bottom" id="scrollToBottomBtn" type="button" title="Scroll to bottom">&#8595;</button>

            <div class="typing-indicator" id="typingIndicator"></div>

            <div class="message-input-area">
                <form class="message-input-form" id="messageForm">
                    <input type="text"
                           class="message-input"
                           id="messageInput"
                           placeholder="Type a message..."
                           maxlength="2000"
                           autocomplete="off" />
                    <button type="submit" class="send-btn" id="sendBtn">Send</button>
                </form>
            </div>
        </div>
    </div>

    <div class="mobile-overlay" id="mobileOverlay"></div>
    <div class="notification" id="notification"></div>
    <div id="voiceAudioContainer" style="display: none;"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script type="module" src="@ClientAssets.Versioned(ClientAssets.RoomEntry)"></script>
</body>
</html>
