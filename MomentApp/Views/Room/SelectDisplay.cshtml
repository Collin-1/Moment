@model MomentApp.Models.SelectDisplayViewModel
@{
    ViewData["Title"] = "Choose how you appear";
    var availableColors = ViewBag.AvailableColors as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="app-panel">
    <h1 class="app-title">How should we call you?</h1>
    <p class="app-sub">This name exists only inside this room, and disappears with it.</p>

    <form asp-action="SelectDisplay" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="RoomCode" />

        <div class="field">
            <label class="field-label" asp-for="DisplayName">Display name</label>
            <input class="field-input"
                   asp-for="DisplayName"
                   maxlength="20"
                   autocomplete="off"
                   autofocus
                   placeholder="Storm" />
            <span class="field-error" asp-validation-for="DisplayName"></span>
        </div>

        <fieldset class="field">
            <legend class="field-label">Your colour</legend>
            @* Colours already taken in this room are absent from the list rather than shown
               disabled: every participant needs a distinct one, and the palette is the real
               cap on room size. *@
            <div class="swatch-grid">
                @foreach (var (name, hex) in availableColors)
                {
                    <label class="swatch" style="--swatch: @hex">
                        <input type="radio" asp-for="ColorHex" value="@hex" />
                        <span>@name</span>
                    </label>
                }
            </div>
            @if (availableColors.Count == 0)
            {
                <p class="field-hint">This room is full &mdash; every colour is in use.</p>
            }
            <span class="field-error" asp-validation-for="ColorHex"></span>
        </fieldset>

        <div class="app-actions">
            <button type="submit" class="button primary">Enter the room</button>
        </div>
    </form>
</div>
