@{
    ViewData["Title"] = "This moment has dissolved";
}

<div class="app-panel dissolve">
    <h1 class="app-title">This moment has dissolved</h1>
    <p class="app-sub">
        Unrecoverable by design. Nothing was written down, so there is nothing to retrieve
        &mdash; not by you, and not by us.
    </p>

    @* Rendered from sessionStorage if the room offered a summary on its way out. It is written
       by the client at close time and never leaves the browser, so a reload or a direct visit
       simply shows nothing rather than reaching for a record that does not exist. *@
    <dl class="summary" id="roomSummary" hidden>
        <div><dt>Room</dt><dd data-summary="roomCode">&mdash;</dd></div>
        <div><dt>Lasted</dt><dd data-summary="duration">&mdash;</dd></div>
        <div><dt>People</dt><dd data-summary="participants">&mdash;</dd></div>
        <div><dt>Messages</dt><dd data-summary="messages">&mdash;</dd></div>
    </dl>

    <div class="app-actions">
        <a class="button primary" asp-action="Create">Open a new moment</a>
        <a class="button secondary" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>

@section Scripts {
    <script type="module" src="/js/closed.js"></script>
}
