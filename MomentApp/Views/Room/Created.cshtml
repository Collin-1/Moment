@using MomentApp.Models
@model RoomCreatedViewModel
@{
    ViewData["Title"] = "Room created";
}

<div class="app-panel">
    <h1 class="app-title">Your new room has been created</h1>
    <p class="app-sub">Share this code to invite others.</p>

    <div class="field">
        <span class="field-label">Room code:</span>
        <p class="room-code">@Model.RoomCode</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.RoomName))
    {
        <div class="field">
            <span class="field-label">Room name:</span>
            <input class="field-input" value="@Model.RoomName" readonly />
        </div>
    }

    <div class="field">
        <label class="field-label" for="shareLink">Share this link:</label>
        <div class="copy-row">
            <input class="field-input" id="shareLink" value="@Model.ShareableLink" readonly />
            <button type="button" class="copy-btn" id="copyLinkBtn" data-copy="#shareLink">Copy</button>
        </div>
        <p class="field-hint">
            Anyone with this link can join until the room expires. It is the only key.
        </p>
    </div>

    <div class="field">
        <span class="field-label">Details:</span>
        <div class="chip-row">
            <label class="chip"><input type="radio" checked disabled /><span>@RoomDuration.Describe(Model.ExpiryMinutes)</span></label>
            <label class="chip"><input type="radio" checked disabled /><span>@Model.RoomType</span></label>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.QRCodeDataUrl))
    {
        <img class="qr" src="@Model.QRCodeDataUrl" alt="QR code linking to this room" width="168" height="168" />
    }

    <div class="app-actions">
        <a class="button primary" asp-action="Index" asp-route-roomCode="@Model.RoomCode">Enter this room</a>
        <a class="button secondary" asp-action="Create">Create another room</a>
    </div>
</div>

@section Scripts {
    <script type="module" src="/js/app.js"></script>
}
